#####################################################################
# Lab01 secret-free UE teaching template
# Profile: lab01-student-zmq-lte
#
# NOT A RUNTIME CONFIG: Instructor/TA must materialize the complete [usim]
# section outside Git. This template intentionally contains no subscriber
# identity, authentication key, operator material, device identity or PIN.
#####################################################################

[rf]
device_name = zmq
device_args = fail_on_disconnect=true,tx_port=tcp://*:2001,rx_port=tcp://10.0.0.1:2000,id=ue,base_srate=23.04e6

[rat.eutra]
dl_earfcn = 3350

[pcap]
enable = none

[log]
all_level = info
phy_lib_level = none
all_hex_limit = 32
filename = stdout

[usim]
# <INSTRUCTOR_PROVISIONED>
# The complete sensitive section is materialized outside this Repository.

[rrc]
# MBMS service fields are intentionally omitted from the core profile.

[nas]
apn = srsapn

[gw]
ip_devname = tun_srsue
ip_netmask = 255.255.255.0

[gui]
enable = false

[phy]
nof_phy_threads = 1
